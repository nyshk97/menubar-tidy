{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ Section": {
      "comment": "A menu item title that toggles the visibility of a section in the menu bar. The argument is the name of the section.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ セクション"
          }
        }
      }
    },
    "%@ Bar": {
      "comment": "The title of the window displayed in the menu bar.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ バー"
          }
        }
      }
    },
    "%@ Settings…": {
      "comment": "The title of the menu item that opens the settings window.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 設定…"
          }
        }
      }
    },
    "%@ can't currently tell which app owns \"%@\", so moving it is disabled. This usually resolves on its own; relaunching the app that owns the item can help.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ can't currently tell which app owns \"%2$@\", so moving it is disabled. This usually resolves on its own; relaunching the app that owns the item can help."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は現在「%@」の所有アプリを特定できないため、移動が無効になっています。通常は自然に解消します。項目を所有するアプリを再起動すると改善する場合があります。"
          }
        }
      }
    },
    "%@ can't locate its hidden-section divider right now. It is attempting recovery in the background — try again in a few seconds.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は現在、非表示セクションの仕切りを見つけられません。バックグラウンドで復旧を試みています。数秒後にもう一度お試しください。"
          }
        }
      }
    },
    "%@ cannot arrange menu bar items in automatically hidden menu bars.": {
      "comment": "A view that shows a message when the menu bar layout can't be arranged in automatically hidden menu bars.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は自動的に非表示になるメニューバーではメニューバー項目を整理できません。"
          }
        }
      }
    },
    "%@ icon": {
      "comment": "The text that will be displayed in the \"Location\" picker view for the Ice Bar.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ アイコン"
          }
        }
      }
    },
    "%@ is currently running. Running multiple menu bar managers at the same time can cause display issues and unexpected behavior. Consider quitting %@ before using %@.": {
      "comment": "A warning alert that appears when a conflicting menu bar manager is detected.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is currently running. Running multiple menu bar managers at the same time can cause display issues and unexpected behavior. Consider quitting %2$@ before using %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は現在実行中です。複数のメニューバーマネージャーを同時に実行すると、表示の問題や予期しない動作が発生する可能性があります。%3$@ を使用する前に %2$@ を終了することをおすすめします。"
          }
        }
      }
    },
    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved.": {
      "comment": "The informative text of the alert displayed when a menu bar item is unresponsive.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は応答していません。再起動するまで移動できません。この問題が解決するまで、他のメニューバー項目の移動にも影響が出る場合があります。"
          }
        }
      }
    },
    "Accessibility": {
      "comment": "Title of the accessibility permission.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        }
      }
    },
    "Active display: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のディスプレイ: %@"
          }
        }
      }
    },
    "Almost there! %@ needs the permissions below to manage your menu bar.": {
      "comment": "Subtitle on the permissions screen reassuring the user they're nearly done. The argument is the name of the app.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Almost there! %@ needs the permissions below to manage your menu bar."
          }
        }
      }
    },
    "Always Hidden": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に非表示"
          }
        }
      }
    },
    "Always-Hidden": {
      "comment": "Localized string key for the \"Always-Hidden\" menu bar section.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に非表示"
          }
        }
      }
    },
    "Apply": {
      "comment": "A button that applies the current value of a slider to a setting.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用"
          }
        }
      }
    },
    "Apply menu bar spacing change?": {
      "comment": "Title of the just-in-time confirmation shown before a display transition relaunches menu bar apps to apply new spacing.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Apply menu bar spacing change?"
          }
        }
      }
    },
    "Arrow": {
      "comment": "Localized string key for each case in the `Name` enum.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印"
          }
        }
      }
    },
    "Cancel": {
      "comment": "The button to cancel the reset action.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Cannot move %@ icon.": {
      "comment": "Alert shown when trying to drag the \\(Constants.displayName) icon out of the visible section.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ アイコンを移動できません。"
          }
        }
      }
    },
    "Check System Settings > Menu Bar and enable %@": {
      "comment": "A message displayed when Thaw is disabled in System Settings and how to solve it.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 > メニューバー を確認して %@ を有効にしてください"
          }
        }
      }
    },
    "Check permissions": {
      "comment": "A button label that, when tapped, opens the app's settings to allow the app to access screen recording permissions.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限を確認"
          }
        }
      }
    },
    "Chevron": {
      "comment": "Localized string key representation of the \"Chevron\" case in the `SectionDividerStyle` enum.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロン"
          }
        }
      }
    },
    "Chevron (Down)": {
      "comment": "Localized string key representation of the \"Chevron (Down)\" case in the `SectionDividerStyle` enum.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェブロン（下向き）"
          }
        }
      }
    },
    "Choose where to move the menu bar items:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目の移動先を選択:"
          }
        }
      }
    },
    "Click menu bar items on your behalf, such as when using the search bar.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Click menu bar items on your behalf, such as when using the search bar."
          }
        }
      }
    },
    "Conflicting Menu Bar Manager Detected": {
      "comment": "Title of an alert that appears when a conflicting menu bar manager is detected.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合するメニューバーマネージャーが検出されました"
          }
        }
      }
    },
    "Continue": {
      "comment": "Label for the \"Continue\" button in the Permissions view.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        }
      }
    },
    "Continue Anyway": {
      "comment": "Title of a button in an alert displayed when a conflicting menu bar management app is detected, allowing the user to continue using Thaw.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま続ける"
          }
        }
      }
    },
    "Continue in Limited Mode": {
      "comment": "Label for the button that allows the user to continue using the app in limited mode, where some features may be restricted.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限モードで続ける"
          }
        }
      }
    },
    "Couldn't move %@ to the always-hidden section.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を常に非表示セクションへ移動できませんでした。"
          }
        }
      }
    },
    "Couldn't move %@ to the hidden section.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を非表示セクションへ移動できませんでした。"
          }
        }
      }
    },
    "Couldn't move the item right now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、この項目を移動できませんでした。"
          }
        }
      }
    },
    "Custom": {
      "comment": "Placeholder name for a custom control item image set.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム"
          }
        }
      }
    },
    "Detect the menu bar items on your Mac and where they're positioned.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Detect the menu bar items on your Mac and where they're positioned."
          }
        }
      }
    },
    "Don't ask again": {
      "comment": "Suppression checkbox on the spacing relaunch confirmation; disables future confirmations.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Don't ask again"
          }
        }
      }
    },
    "Door": {
      "comment": "Name of the \"Door\" control item image.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドア"
          }
        }
      }
    },
    "Dot": {
      "comment": "Description of a control item with a dot shape.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドット"
          }
        }
      }
    },
    "Dynamic": {
      "comment": "Localized string key representation of the Ice Bar location option \"Dynamic\".",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイナミック"
          }
        }
      }
    },
    "Edit Menu Bar Layout…": {
      "comment": "Label for a menu item that opens the menu bar layout settings.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのレイアウトを編集…"
          }
        }
      }
    },
    "Ellipsis": {
      "comment": "Description of an ellipsis icon.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "省略記号"
          }
        }
      }
    },
    "Enable Permissions": {
      "comment": "Title of the permissions screen shown during onboarding.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Enable Permissions"
          }
        }
      }
    },
    "Find menu bar items visually when searching.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Find menu bar items visually when searching."
          }
        }
      }
    },
    "Focus": {
      "comment": "Localized string key for the \"Focus\" case in the `RehideStrategy` enum.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス"
          }
        }
      }
    },
    "Grant Permission": {
      "comment": "A button label that requests permission from the user.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限を許可"
          }
        }
      }
    },
    "Grid": {
      "comment": "Label for the grid layout mode.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッド"
          }
        }
      }
    },
    "Hidden": {
      "comment": "Localized string key for the \"Hidden\" menu bar section.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示"
          }
        }
      }
    },
    "Hide Always-Hidden Section": {
      "comment": "Title for a menu bar item that hides an always-hidden section.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に非表示セクションを隠す"
          }
        }
      }
    },
    "Hide Hidden Section": {
      "comment": "Title of a menu item that toggles the visibility of a hidden section in the menu bar.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示セクションを隠す"
          }
        }
      }
    },
    "Horizontal": {
      "comment": "Localized string key for the horizontal layout mode.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水平"
          }
        }
      }
    },
    "Ice Cube": {
      "comment": "Localized string key for the Ice Cube control item image.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice Cube"
          }
        }
      }
    },
    "Items were moved to the Visible section.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を表示セクションへ移動しました。"
          }
        }
      }
    },
    "Layout reset. Items were moved to the Always Hidden section.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトをリセットしました。項目を常に非表示セクションへ移動しました。"
          }
        }
      }
    },
    "Layout reset. Items were moved to the Hidden section.": {
      "comment": "A message displayed after successfully resetting the menu bar layout.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトをリセットしました。項目は非表示セクションに移動されました。"
          }
        }
      }
    },
    "Left aligned": {
      "comment": "Text displayed in a button to align the Thaw Bar to the left edge of the display.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左揃え"
          }
        }
      }
    },
    "Loading menu bar items…": {
      "comment": "A message displayed while waiting for menu bar items to load.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目を読み込んでいます…"
          }
        }
      }
    },
    "Menu Bar Layout": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのレイアウト"
          }
        }
      }
    },
    "Menu bar item is not movable.": {
      "comment": "Message text in an alert that appears when a menu bar item is not movable.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメニューバー項目は移動できません。"
          }
        }
      }
    },
    "Menu bar layout requires screen recording permissions.": {
      "comment": "A message displayed when the user does not have the necessary permissions to change the menu bar layout.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのレイアウトには画面収録の権限が必要です。"
          }
        }
      }
    },
    "Mouse pointer": {
      "comment": "Localized string key for the \"Mouse pointer\" option in the Ice Bar location picker.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスポインター"
          }
        }
      }
    },
    "Move menu bar items to rearrange or hide them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Move menu bar items to rearrange or hide them."
          }
        }
      }
    },
    "New Items": {
      "comment": "Title of a badge that displays the number of new items.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新着アイテム"
          }
        }
      }
    },
    "No items in this section": {
      "comment": "A message displayed when a section of the Ice Bar has no items.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセクションに項目はありません"
          }
        }
      }
    },
    "Not enough room to show \"%@\"": {
      "comment": "Title of an alert that appears when there is not enough room to show a menu bar item.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" を表示するスペースが不足しています"
          }
        }
      }
    },
    "Notch": {
      "comment": "A label describing a display with a notch.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチ"
          }
        }
      }
    },
    "One or more section dividers are hidden by macOS": {
      "comment": "A message displayed when macOS hides one or more section dividers in the menu bar.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つ以上のセクション区切りが macOS によって非表示にされています"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        }
      }
    },
    "Permission Granted": {
      "comment": "A label indicating that a user has granted a permission.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限が許可されました"
          }
        }
      }
    },
    "Permissions": {
      "comment": "The title of the permissions view.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限"
          }
        }
      }
    },
    "Profiles": {
      "comment": "The title of the \"Profiles\" section in the \"Settings\" interface.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル"
          }
        }
      }
    },
    "Quit": {
      "comment": "A button label that quits the application.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了"
          }
        }
      }
    },
    "Quit %@": {
      "comment": "A button that quits the app.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を終了"
          }
        }
      }
    },
    "Reset Layout…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトをリセット…"
          }
        }
      }
    },
    "Reset completed with %lld item(s) that could not be moved. Check the menu bar and try again if needed.": {
      "comment": "A message describing the result of a menu bar layout reset, including the number of items that could not be moved.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットが完了しましたが、%lld 個の項目を移動できませんでした。必要に応じてメニューバーを確認し、再試行してください。"
          }
        }
      }
    },
    "Reset failed: %@": {
      "comment": "A message that is displayed when the menu bar layout reset fails. The argument is a message describing the failure.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットに失敗しました: %@"
          }
        }
      }
    },
    "Reset menu bar layout": {
      "comment": "A label for a button that resets the menu bar layout.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのレイアウトをリセット"
          }
        }
      }
    },
    "Resets dividers and moves every movable item except the %@ icon to the selected section.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕切りをリセットし、%@ のアイコンを除く移動可能なすべての項目を選択したセクションへ移動します。"
          }
        }
      }
    },
    "Restart %@": {
      "comment": "A button that restarts the app.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を再起動"
          }
        }
      }
    },
    "Right aligned": {
      "comment": "Localized string key for the right-aligned Thaw Bar location.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右揃え"
          }
        }
      }
    },
    "Sample colors from the menu bar to adjust its tint and appearance.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Sample colors from the menu bar to adjust its tint and appearance."
          }
        }
      }
    },
    "Screen Recording": {
      "comment": "Title of the screen recording permission.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録"
          }
        }
      }
    },
    "Show Always-Hidden Section": {
      "comment": "Title of a menu item that shows an always-hidden section in the menu bar.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に非表示セクションを表示"
          }
        }
      }
    },
    "Show Hidden Section": {
      "comment": "Title of a menu item that shows a hidden section in the menu bar.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示セクションを表示"
          }
        }
      }
    },
    "Show live previews of your menu bar items.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Show live previews of your menu bar items."
          }
        }
      }
    },
    "Smart": {
      "comment": "Localized string key for the \"Smart\" rehide strategy.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート"
          }
        }
      }
    },
    "Sunglasses": {
      "comment": "Localized string key for the \"Custom\" control item image.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サングラス"
          }
        }
      }
    },
    "Support %@…": {
      "comment": "A menu item that opens a URL for supporting the app. The system image is a filled circle with a heart.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をサポート…"
          }
        }
      }
    },
    "The %@ Bar requires screen recording permissions.": {
      "comment": "A message displayed when the user hasn't granted the app permission to access the screen. Clicking the button opens the app's settings to grant the permission.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ バーには画面収録の権限が必要です。"
          }
        }
      }
    },
    "The %@ icon must always remain in the visible section.": {
      "comment": "The message text in an alert that appears when the user tries to drag the \\(Constants.displayName) icon out of the visible section.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ アイコンは常に表示セクション内に置く必要があります。"
          }
        }
      }
    },
    "The item was left in the visible section so it isn't stuck offscreen. Try dragging it again in a moment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面外で動かせなくならないよう、この項目は表示セクションに残しました。少し時間をおいてから、もう一度ドラッグしてみてください。"
          }
        }
      }
    },
    "This version of Thaw is not yet compatible with macOS 27. Preview builds are available on GitHub Releases, and macOS 27 support will be delivered through the alpha update channel.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの Thaw は macOS 27 にまだ対応していません。プレビュービルドは GitHub Releases で公開されており、macOS 27 対応は alpha アップデートチャンネルで配信されます。"
          }
        }
      }
    },
    "Timed": {
      "comment": "Localized string key for the \"Timed\" option in the \"Auto-rehide\" settings.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間指定"
          }
        }
      }
    },
    "Unable to display menu bar items": {
      "comment": "A message displayed when the menu bar items cannot be displayed.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目を表示できません"
          }
        }
      }
    },
    "Unable to load menu bar items": {
      "comment": "A message displayed when the app is unable to load the user's menu bar items.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目を読み込めません"
          }
        }
      }
    },
    "Untitled": {
      "comment": "Name of an unnamed profile.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無題"
          }
        }
      }
    },
    "Vertical": {
      "comment": "Label for the vertical layout mode.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "垂直"
          }
        }
      }
    },
    "View Preview Builds": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュービルドを見る"
          }
        }
      }
    },
    "Visible": {
      "comment": "Localized string key for the display string of a menu bar section.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示"
          }
        }
      }
    },
    "When a display transition requires Thaw to apply a different menu bar spacing, Thaw relaunches apps with menu bar items. Relaunching apps may cause unsaved input, progress, or transient app state to be lost.": {
      "comment": "A warning that a display transition requiring a different menu bar spacing relaunches menu bar apps, which can lose unsaved state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When a display transition requires Thaw to apply a different menu bar spacing, Thaw relaunches apps with menu bar items. Relaunching apps may cause unsaved input, progress, or transient app state to be lost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "When a display transition requires Thaw to apply a different menu bar spacing, Thaw relaunches apps with menu bar items. Relaunching apps may cause unsaved input, progress, or transient app state to be lost."
          }
        }
      }
    },
    "Your data stays on your Mac — nothing is ever collected or shared.": {
      "comment": "A privacy reassurance shown on the permissions screen.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "new",
            "value": "Your data stays on your Mac — nothing is ever collected or shared."
          }
        }
      }
    },
    "left click": {
      "comment": "The accessibility action name for a left click on an ice bar item.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左クリック"
          }
        }
      }
    },
    "macOS 27 Is Not Yet Supported": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27 は未対応です"
          }
        }
      }
    },
    "macOS prohibits \"%@\" from being moved.": {
      "comment": "The text that appears below the main message text in the alert displayed when a menu bar item is not movable.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS により \"%@\" は移動できません。"
          }
        }
      }
    },
    "right click": {
      "comment": "A named accessibility action for a right click on an ice bar item.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右クリック"
          }
        }
      }
